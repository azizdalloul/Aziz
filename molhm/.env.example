# ===== Supabase (لا تضع قيماً حقيقية في المستودع) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# خادمي فقط — لا تضف بادئة NEXT_PUBLIC أبداً
SUPABASE_SERVICE_ROLE_KEY=

# ===== الموقع =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/97466028459
# اجعلها true لإلزام MFA (aal2) لدخول لوحة الإدارة
REQUIRE_MFA=false

# ===== الحماية من الإساءة (اختياري: Cloudflare Turnstile) =====
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# ملح لتجزئة عناوين IP (سلسلة عشوائية طويلة)
IP_HASH_SALT=

# ===== Google Sheets (Service Account، اتجاه واحد) =====
# شارك الملف مع بريد الـ Service Account كمحرر. الملف يجب أن يكون مقيّد الصلاحيات.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
# true فقط إذا كان الملف مقيّداً ومعتمداً لاستقبال درجات التقييم السبعة
SHEETS_INCLUDE_SCORES=false

# ===== مهام مجدولة (Vercel Cron) =====
CRON_SECRET=

# ===== بريد الفريق (اختياري، بعد الموافقة) =====
TEAM_EMAIL_WEBHOOK_URL=
